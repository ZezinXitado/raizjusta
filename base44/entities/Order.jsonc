{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string"
    },
    "total": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "confirmado",
        "preparando",
        "enviado",
        "entregue"
      ],
      "default": "confirmado"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "qty": {
            "type": "number"
          },
          "image": {
            "type": "string"
          },
          "producer": {
            "type": "string"
          },
          "producerId": {
            "type": "string"
          },
          "sustainable": {
            "type": "boolean"
          }
        }
      }
    },
    "impact": {
      "type": "object",
      "properties": {
        "producersSupported": {
          "type": "number"
        },
        "amountToProducers": {
          "type": "number"
        },
        "sustainablePractices": {
          "type": "number"
        },
        "cooperativas": {
          "type": "number"
        },
        "distance": {
          "type": "number"
        }
      }
    }
  },
  "required": [
    "order_number",
    "total",
    "status",
    "items",
    "impact"
  ]
}